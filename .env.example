# Copia a .env (nunca se versiona). En GitHub Actions estos valores van en Settings → Secrets.
CLAUDE_CODE_OAUTH_TOKEN=            # `claude setup-token` (suscripción Pro; caduca al año)
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-tts.json   # cuenta de servicio con Text-to-Speech
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=               # permiso Workers AI
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/token.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
